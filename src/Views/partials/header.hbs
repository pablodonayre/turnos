<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>

    {{#if use_spaces }}
    <link href="https://mastercoders-minimarket.nyc3.cdn.digitaloceanspaces.com/Libraries/third_party/bootstrap-5.0.2-dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://mastercoders-minimarket.nyc3.cdn.digitaloceanspaces.com/Libraries/third_party/fontawesome-5.6.3-web/css/all.css">
    <link rel="stylesheet" href="https://mastercoders-minimarket.nyc3.cdn.digitaloceanspaces.com/Libraries/css/alerts.css">
    <link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.18.3/dist/bootstrap-table.min.css">
    {{else}}
    <link href="/Libraries/bootstrap-5.0.2-dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/Libraries/fontawesome-5.6.3-web/css/all.css">
    <link rel="stylesheet" href="/Libraries/master_coders/css/alerts.css">
    <link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.18.3/dist/bootstrap-table.min.css">
    {{/if}}

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="/img/background/logo.ico" type="image/x-icon">

    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; color: #333; }
        .nav-link {
            font-weight: 500;
            color: #555;
            transition: all 0.2s;
            border-bottom: 2px solid transparent;
        }
        .sticky-top { z-index: 1020; border-bottom: 1px solid rgba(0, 0, 0, 0.05); }
        .nav-link.active {
            color: #0d6efd !important;
            border-bottom: 2px solid #0d6efd !important;
            background-color: rgba(13, 110, 253, 0.05);
        }
        @media (max-width: 991px) {
            .nav-link.active {
                border-bottom: none !important;
                border-left: 4px solid #0d6efd;
                background-color: #f0f7ff;
                border-radius: 0 8px 8px 0;
            }
            .user-display { padding: 0.5rem 1rem; }
        }
        .btn-logout {
            background: none;
            border: none;
            color: #555;
            font-weight: 500;
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
        }
        .btn-logout:hover { color: #dc3545; }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/home">
                <img src="/img/background/logo_icon.png" class="logos mx-auto mb-1 d-sm-none">
                <img src="/img/background/logo.png" class="logos mx-auto mb-1 d-none d-sm-inline-block">
            </a>

            <div class="ms-auto me-2 me-lg-0 order-2 order-lg-2 d-flex align-items-center">
                <div class="ms-lg-3 d-flex align-items-center me-3">
                    <span class="text-dark fw-bold user-display d-flex align-items-center" style="pointer-events: none;">
                        <i class="fas fa-user me-1 text-secondary"></i>
                        {{#if user.nombre}} {{user.nombre}}
                        {{else if user.username}} {{user.username}}
                        {{else if user.user_id}} ID: {{user.user_id}}
                        {{else}} Sesión activa {{/if}}
                    </span>
                </div>

                <button class="navbar-toggler shadow-none border-secondary" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="d-none d-lg-block ms-2 order-lg-3">
                <form action="/auth/logout" method="post" class="m-0">
                    <button class="btn btn-outline-danger" type="submit">
                        <i class="fas fa-sign-out-alt me-2"></i> Cerrar sesión
                    </button>
                </form>
            </div>

            <div class="collapse navbar-collapse order-lg-1" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link px-3" href="/home" data-seccion="home">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="/logs" data-seccion="logs">Historial</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="/usuario" data-seccion="usuario">Usuarios</a></li>
                    {{#if is_admin}}
                    <li class="nav-item"><a class="nav-link px-3" href="/turnos" data-seccion="turnos">Turnos</a></li>
                    {{/if}}
                    <li class="nav-item d-lg-none">
                        <form action="/auth/logout" method="post" class="m-0">
                            <button class="btn-logout" type="submit">
                                <i class="fas fa-sign-out-alt me-2"></i> Cerrar sesión
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => {
                const seccion = link.getAttribute('data-seccion');
                if (seccion && currentPath.includes(seccion)) {
                    link.classList.add('active');
                }
            });
        });
    </script>

</body>

</html>