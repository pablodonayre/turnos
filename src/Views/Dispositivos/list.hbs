{{> header }}

<div class="container-fluid py-2 py-md-5 px-3 px-md-4">
    <div class="p-3 p-md-5 rounded-4 shadow-sm border bg-white">
        <h2 class="display-6 fw-normal mb-4">Dispositivos:</h2>

        <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
            <div class="position-relative" style="max-width: 300px; width: 100%;">
                <input type="text" id="inputBuscar" class="form-control" placeholder="Buscar dispositivo" oninput="buscar(this, document.getElementById('btnLimpiar'), $('#table'))">
                <button id="btnLimpiar"
                        class="btn position-absolute top-50 end-0 translate-middle-y border-0 text-muted d-none"
                        type="button" style="margin-right: 10px;"
                        onclick="limpiar(document.getElementById('inputBuscar'), this, $('#table'))">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <button type="button" onclick="abrirModalNuevo()" class="btn btn-outline-primary shadow-sm">
                <span class="d-none d-sm-inline-block">Añadir dispositivo &nbsp;</span>
                <i class="fas fa-plus"></i>
            </button>
        </div>

        <div class="modal fade" id="modalDispositivo" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalDispositivoTitulo">Nuevo Dispositivo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        {{!-- <input type="hidden" id="dispositivoId"> --}}
                        <div id="modalError" class="alert alert-danger d-none" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Nombre<span class="text-danger"> *</span></label>
                            <input type="text" id="nombre" class="form-control border shadow-sm rounded-3" maxlength="200" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Modo<span class="text-danger"> *</span></label>
                            <select id="modo"></select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Ms<span class="text-danger"> *</span></label>
                            <input type="number" id="ms" class="form-control border shadow-sm rounded" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-dismiss="modal">
                            Cancelar &nbsp;<i class="fas fa-undo"></i>
                        </button>
                        <button type="button" onclick="validarDispositivo()" class="btn btn-sm btn-outline-primary">
                            Guardar &nbsp;<i class="fas fa-save"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form id="modalEliminarDispositivoForm" class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar Acción</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p id="modalMessage"></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-dismiss="modal">
                            Cancelar &nbsp;<i class="fas fa-undo"></i>
                        </button>
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            Eliminar &nbsp;<i class="fas fa-trash"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table id="table" class="table"></table>
        </div>
    </div>
</div>

{{> footer}}

<script src="https://cdn.jsdelivr.net/npm/luxon@2.0.2/build/global/luxon.min.js"></script>
<script>
    let dispositivoAEliminarId = null;
    let dispositivoAEditarId = null;
    
    const modalDispositivo = new bootstrap.Modal(document.getElementById('modalDispositivo'));
    const myModal = new bootstrap.Modal(document.getElementById('modalEliminar'));

    $('#modo').select2({
        data: [{
            id: "ASISTENCIA",
            text: "ASISTENCIA"
        }, {
            id: "REGISTRO",
            text: "REGISTRO"
        }, {
            id: "BLOQUEADO",
            text: "BLOQUEADO"
        }, {
            id: "TEST",
            text: "TEST"
        }],
        width: '100%',
        dropdownParent: $('#modalDispositivo')
    })

    function mostrarErrorModal(msg, tipo = 'danger') {
        $('#modalError').removeClass('alert-danger alert-warning').addClass(`alert-${tipo}`).text(msg).removeClass('d-none');
    }

    function limpiarErrorModal() {
        $('#modalError').addClass('d-none').text('');
    }
   
    function abrirModalNuevo() {
        $('#nombre').val('');
        $('#modo').val('TEST');
        $('#modo').trigger('change');
        $('#ms').val('3000');

        $('#modalDispositivoTitulo').text('Nuevo Dispositivo');
        modalDispositivo.show();
    }

    function abrirModalEditar(dispositivo) {
        //console.log(d)
        //const dispositivo = JSON.parse(d);

        $('#nombre').val(dispositivo.nombre);
        $('#modo').val(dispositivo.modo);
        $('#modo').trigger('change');
        $('#ms').val(dispositivo.test_interval_ms);

        dispositivoAEditarId = dispositivo.id;

        $('#modalDispositivoTitulo').text('Editar Dispositivo');
        modalDispositivo.show();
    }


    function validarDispositivo() {
        limpiarErrorModal();

        const id = dispositivoAEditarId;
        const nombre = $('#nombre').val().trim();
        const modo = $('#modo').val();
        const test_interval_ms = $('#ms').val();

        if (nombre.length < 1) {
            $('#nombre').focus();
            mostrarErrorModal("El nombre es requerido.");
            return;
        }

        const data = { nombre, modo, test_interval_ms };

        const url = dispositivoAEditarId ? `/dispositivos/data/${dispositivoAEditarId}` : '/dispositivos/data';
        const method = dispositivoAEditarId ? 'PUT' : 'POST';

        fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(res => res.json())
        .then(dataResponse => {
            if (dataResponse.ok && dataResponse.msg === 'sin cambios') {
                mostrarErrorModal('No hiciste ningún cambio.', 'warning');
            } else if (dataResponse.ok) {
                modalDispositivo.hide();
                $('#table').bootstrapTable('refresh');
                dispositivoAEditarId = null;
            } else {
                mostrarErrorModal(dataResponse.msg);
            }
        })
        .catch(() => {
            mostrarErrorModal("Error al guardar el dispositivo.");
        });
    }

    $(document).ready(function () {
        $('#table').bootstrapTable({
            url: "{{{ url_data }}}",
            search: true,
            pagination: true,
            serverSort: true,
            sidePagination: "server",
            searchHighlight: true,
            showSearchClearButton: true,
            showExtendedPagination: true,
            pageSize: 50,
            queryParams: queryParams,
            searchSelector: "#inputBuscar",
            responseHandler: responseHandler,
            columns: [
                { field: 'nombre', title: 'Nombre', sortable: true },
                {
                    field: 'modo', title: 'Modo', sortable: true
                },
                { field: 'test_interval_ms', title: 'Ms', sortable: true },
                {
                    field: 'acciones', title: 'Acciones', align: 'center',
                    formatter: function (value, row) {
                        const btn_borrar = `<button class="btn btn-sm btn-outline-danger btn-eliminar"
                                    data-id="${row.id}" data-titulo="${row.titulo}" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>`;
                        return `
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-primary btn-editar" data-id="${row.id}" data-row="` + JSON.stringify(row).replace(/"/g, '&quot;')+ `" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                
                        `;
                    }
                },
            ],
            formatNoMatches: function () { return 'No se encontraron dispositivos'; },
            formatLoadingMessage: function () { return 'Cargando, espere por favor'; }
        });
        $(document).on('click', '.btn-editar', function () {
            const id = $(this).data('id');
            const row = $(this).data('row');

            abrirModalEditar(row)
        });

        $(document).on('click', '.btn-eliminar', function () {
            dispositivoAEliminarId = $(this).data('id');
            document.getElementById('modalMessage').innerHTML =
                `¿Está seguro que desea eliminar el dispositivo <strong>${$(this).data('titulo')}</strong>?`;
            myModal.show();
        });

        document.getElementById('modalEliminarDispositivoForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch(`/dispositivos/data/${dispositivoAEliminarId}`, { method: 'PUT',
                body: JSON.stringify({
                    deactivate: true
                }) })
                .then(res => res.json())
                .then(dataResponse => {
                    myModal.hide();
                    if (dataResponse.ok) {
                        $('#table').bootstrapTable('refresh');
                    } else {
                        showAlerts(dangerAlert, dangerMessage, dataResponse.msg);
                    }
                })
                .catch(() => {
                    myModal.hide();
                    showAlerts(dangerAlert, dangerMessage, "Error al eliminar el dispositivo.");
                });
        });
    });
</script>