{{> header }}

<div class="container-fluid py-2 py-md-5 px-3 px-md-4">
    <div class="p-3 p-md-5 rounded-4 shadow-sm border bg-white">
        <h2 class="display-6 fw-normal mb-4">Registrar Turno:</h2>

        {{> alerts}}

        <div class="mb-1">
            <div id="estadoUsuario" class="mb-3">
                Consultando estado...
            </div>
        </div>

        <form id="formTurno">
            <div class="mb-1">
                <label class="col-form-label fw-bold">Archivo <span class="text-danger">*</span></label>
                <div class="drop-zone" id="drop-file-ingreso">
                    <input type="file" id="archivo" disabled style="pointer-events: none;">
                    <div class="drop-zone-label">
                        <i class="fas fa-cloud-upload-alt me-1"></i>Arrastra aquí o <u>haz clic</u>
                    </div>
                </div>
                <input id="archivo_server" type="text" hidden>
                <input id="archivo_usuario" type="text" hidden>
                <div id="archivo-actual" class="mt-1" style="display:none;">
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <a id="archivo-actual-link" href="#" target="_blank" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-external-link-alt"></i>
                        </a>

                        <a id="archivo-actual-link2" href="#" data-title="" class="preview_file btn btn-sm btn-outline-secondary">
                            <i class="fas fa-file"></i> <span id="archivo-actual-nombre"></span>
                        </a>

                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="cambiarArchivo()">
                            <i class="fas fa-exchange-alt"></i> Cambiar
                        </button>
                    </div>
                </div>
                <div id="status-file-ingreso" class="status-wrapper mt-1"></div>
            </div>

            <div class="mb-3">
                <label for="text" class="col-form-label fw-bold" data-label="text">Descripción <span class="text-danger">*</span></label>
                <textarea id="descripcion" rows="3" class="form-control"></textarea>
            </div>

            <button type="submit" id="btnTurno" class="btn btn-primary" disabled>Consultando ..</button>
        </form>

        {{!-- info del ultimo registro --}}
        <div id="ultimo_registro" class="mt-4" style="display: none;">
            <hr>

            <h5 class="fw-bold mb-3"> <i class="fas fa-history me-1"></i>Último registro</h5>

            <div class="card border-0 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div id="ultimoRegistroIcono" class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:45px;height:45px;">
                            <i id="ultimoRegistroIconoFa"></i>
                        </div>

                        <div>
                            <div id="ultimoRegistroAccion" class="fw-bold fs-5"></div>
                            <div id="ultimoRegistroFecha" class="text-muted"></div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <span class="fw-bold">Descripción:</span>
                        <span id="ultimoRegistroDescripcion"></span>
                    </div>

                    <div id="ultimoRegistroAlerta" class="alert alert-warning mb-0" style="display:none;">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        <span id="ultimoRegistroAlertaMsg"></span>
                    </div>

                    <div class="mt-3">

                        <button type="button" id="btnVerUbicacion" class="btn btn-sm btn-outline-primary" style="display:none;">
                            <i class="fas fa-map-marker-alt me-1"></i>
                            Ver ubicación
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="contenedor_mapa" class="mt-4" style="display: none">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="fas fa-map-marker-alt me-1"></i> Ubicación registrada</h6>

                <button type="button" id="btn_cerrar_mapa" class="btn btn-sm btn-outline-secondary">Ocultar</button>
            </div>
            
            <iframe id="map_frame" width="100%" height="300" style="border: 0; border-radius: 10px" loading="lazy" allowfullscreen></iframe>
        </div>


        <div class="mt-4">

            <p class="mb-1">
                <b>IMPORTANTE:</b>
            </p>

            <p class="text-muted mb-0">
                Para registrar esta operación, se utilizará la ubicación actual de su dispositivo. Al continuar, deberá permitir el acceso a su ubicación cuando el navegador lo solicite.
            </p>

        </div>
        
    </div>
</div>

{{> footer}}

<script>
    let estadoUsuario = null;

    consultarEstado();
    function consultarEstado(){

        // limpiando formulario inicial
        $('#descripcion').val("");
        $('#archivo_server').val('');
        $('#archivo_usuario').val('');
        document.getElementById("archivo").value = "";
        document.getElementById('status-file-ingreso').innerHTML = '';
        document.getElementById('archivo-actual').style.display = 'none';

        $('#drop-file-ingreso').show().css({'opacity': '1', 'pointer-events': 'auto'});
        document.getElementById('archivo').removeAttribute('disabled');
        document.querySelector('#drop-file-ingreso .drop-zone-label').innerHTML = `<i class="fas fa-cloud-upload-alt me-1"></i>Arrastra aquí o <u>haz clic</u>`;

        fetch('/sesion/data', {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' },
        })
        .then(res => res.json())
        .then(data => {
            if(data.redirect){
                location.href = data.redirect;
                return;
            }

            if(data.flash == "danger"){
                showAlerts(dangerAlert, dangerMessage, data.msg);
                return;
            }

            estadoUsuario = data.usuario.estado;

            if(data.usuario.estado == 1){
                $('#estadoUsuario').html('<span class="badge bg-success">Turno activo</span>');

                $('#btnTurno').text('Finalizar turno').removeClass('btn-primary').addClass('btn-danger').prop('disabled', false);
            } else {
                $('#estadoUsuario').html('<span class="badge bg-secondary">Turno no iniciado</span>');

                $('#btnTurno').text('Iniciar turno').removeClass('btn-danger').addClass('btn-primary').prop('disabled', false);
            }

            /*
            if(data.log.ubicacion){
                $('#map_frame').attr('src', `https://www.google.com/maps?q=${ data.log.ubicacion }&output=embed`);
            }
            */

            // mostrando los datos del ultimo registro
            mostrarUltimoRegistro(data.ubicacion);

            console.log('data', data)
        })
        .catch(function(error){
            showAlerts(dangerAlert, dangerMessage, error.message);
            $('#estadoUsuario').html('<span class="badge bg-danger">No se pudo consultar el estado</span>');

            $('#btnTurno').text('Reintentar').prop('disabled', false);
        })
    }

    function mostrarUltimoRegistro(data){

        console.log('ultimo reg', data)
        if(!data){
            $('#ultimo_registro').hide()
            return;
        }

        $('#ultimo_registro').show();

        const es_entrada = data.accion === "ENTRADA";

        // accion
        $('#ultimoRegistroAccion').text(es_entrada ? 'Entraste a tu turno' : 'Saliste de tu turno');

        // icono
        if(es_entrada){
            $('#ultimoRegistroIcono').removeClass('bg-danger bg-opacity-10').addClass('bg-success bg-opacity-10');
            $('#ultimoRegistroIconoFa').removeClass('fa-sign-out-alt').addClass('fas fa-sign-in-alt text-success');
        } else {
            $('#ultimoRegistroIcono').removeClass('bg-success bg-opacity-10').addClass('bg-danger bg-opacity-10');
            $('#ultimoRegistroIconoFa').removeClass('fa-sign-in-alt').addClass('fas fa-sign-out-alt text-danger');
        }

        // fecha y hora
        $('#ultimoRegistroFecha').text(formatearFechaHora(data.fecha_hora));

        // descripcion
        $('#ultimoRegistroDescripcion').text(data.comentario || 'Sin descripcion');

        // alerta
        //if (data.alerta == 1 && data.alerta_msg) {
            $('#ultimoRegistroAlertaMsg').text(data.alerta_msg);
            $('#ultimoRegistroAlerta').show();
        //} else {
        //    $('#ultimoRegistroAlerta').hide();
        //}

        // ubicacion
        if(data.ubicacion){
            $('#btnVerUbicacion').show().off('click').on('click', function() {
                mostrarMapa(data.ubicacion);
            })
        } else {
            $('#btnVerUbicacion').hide();
        }
    }

    function formatearFechaHora(timestamp){
        const fecha = new Date(Number(timestamp));

        return fecha.toLocaleString('es-PE', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        })
    }

    function mostrarMapa(ubicacion){
        const url = `https://www.google.com/maps?q=${ ubicacion }&output=embed`;

        $('#map_frame').attr('src', url);
        $('#contenedor_mapa').slideDown();
    }

    $('#btn_cerrar_mapa').on('click', function () {
        $('#contenedor_mapa').slideUp();
    });

    $('#formTurno').on('submit', function(e){
        e.preventDefault();
        obtenerUbicacion()
    })

    if(!navigator.geolocation){
        showAlerts(dangerAlert, dangerMessage, "Su dispositivo o navegador no permite obtener la ubicación, por favor brinda los permisos y actualiza la página");
    }

    function obtenerUbicacion(){
        navigator.geolocation.getCurrentPosition(
            function (position) {

                const latitud = position.coords.latitude;
                const longitud = position.coords.longitude;

                enviarTurno(latitud, longitud);
            },

            function(error){
                console.log(error)
                showAlerts(dangerAlert, dangerMessage, "No se pudo obtener su ubicación. Debe permitir el acceso a su ubicación para continuar.");
            },

            {
                enableHighAccuracy: true,
                timeout: 5000,
                maximumAge: 0,
            }
        )
    }

    function enviarTurno(lat, long){
        fetch('/rfid/device', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                accion: estadoUsuario == 1 ? "SALIDA" : "ENTRADA",
                ubicacion: lat + ", " + long,
                descripcion: $('#descripcion').val(),
                archivo_server: $('#archivo_server').val(),
                archivo_usuario: $('#archivo_usuario').val(),
            })
        })
        .then(res => res.json())
        .then(data => {
            if(data.redirect){
                location.href = data.redirect;
                return;
            }

            if(data.flash == "danger"){
                showAlerts(dangerAlert, dangerMessage, data.msg);
                return;
            }

            estadoUsuario = data.nuevo_estado;

            consultarEstado();
            /*
            if(estadoUsuario == 1){
                $('#estadoUsuario').html('<span class="badge bg-success">Turno activo</span>');

                $('#btnTurno').text('Finalizar turno').removeClass('btn-primary').addClass('btn-danger').prop('disabled', false);
            } else {
                $('#estadoUsuario').html('<span class="badge bg-secondary">Turno no iniciado</span>');

                $('#btnTurno').text('Iniciar turno').removeClass('btn-danger').addClass('btn-primary').prop('disabled', false);
            }
            */

            /*
            detalleDelResultado: "HABILITADO"
            duplicado: false
            habilitado: false
            modo: "ASISTENCIA"
            usuario: "Kimberly Ruiz"
            nuevo_estado: 0 | 1
            */

    
            console.log('data', data)
        })
        .catch(function(error){
            showAlerts(dangerAlert, dangerMessage, error.message);
            $('#estadoUsuario').html('<span class="badge bg-danger">No se pudo consultar el estado</span>');

            $('#btnTurno').text('Reintentar').prop('disabled', false);
        })

    }

    /* Adjuntos */
    //drag & drop
    (function setupDropZoneIngreso() {
        const input = document.getElementById('archivo');
        const zone = document.getElementById('drop-file-ingreso');

        zone.addEventListener('click', () => {
            if (!input.disabled) input.click();
        });

        zone.addEventListener('dragover', (e) => {
            e.preventDefault();
            if (!input.disabled) zone.classList.add('dragover');
        });
        zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.classList.remove('dragover');
            if (input.disabled) return;
            if (e.dataTransfer.files.length > 0) {
                const dt = new DataTransfer();
                dt.items.add(e.dataTransfer.files[0]);
                input.files = dt.files;
                uploadFile();
            }
        });
        input.addEventListener('change', () => {
            if (input.files.length > 0) uploadFile();
        });
    })();

    async function uploadFile() {
        const input = document.getElementById('archivo');
        const statusDiv = document.getElementById('status-file-ingreso');
        const files = input.files;
        const max_kb = 10 * 1000;
        const formData = new FormData();

        if (!files.length) return;

        statusDiv.innerHTML = `<div class="loading-spinner"></div><span class="small text-muted">Cargando...</span>`;

        for (let file of files) {
            if (file.size / 1000 > max_kb) {
                showAlerts(dangerAlert, dangerMessage, 'Tamaño máximo de archivo: 10 MB');
                statusDiv.innerHTML = '';
                return;
            }
            formData.append('imgUploader', file, file.name);
        }

        try {
            const response = await fetch("{{{ url_upload }}}", { method: 'POST', body: formData });
            const data = await response.json();
            if (data.flash === 'danger') {
                statusDiv.innerHTML = '';
                showAlerts(dangerModalAlert, dangerModalMessage, data.msg);
            } else {
                statusDiv.innerHTML = `<i class="fas fa-check-circle text-success fs-5"></i><span class="text-success ms-1 small fw-bold">Listo</span>`;
                $('#archivo_server').val(data.files[0].archivo_server);
                $('#archivo_usuario').val(data.files[0].archivo_usuario);
                // Actualizar label del drop zone
                document.querySelector('#drop-file-ingreso .drop-zone-label').innerHTML =
                    `<i class="fas fa-file me-1 text-success"></i><strong>${data.files[0].archivo_usuario}</strong>`;
            }
        } catch (err) {
            statusDiv.innerHTML = '';
            showAlerts(dangerAlert, dangerMessage, 'Error al subir el archivo.');
        }
    }    

    function cambiarArchivo() {
        document.getElementById('archivo-actual').style.display = 'none';
        $('#drop-file-ingreso').show().css({'opacity': '1', 'pointer-events': 'auto'});
        document.querySelector('#drop-file-ingreso .drop-zone-label').innerHTML = `<i class="fas fa-cloud-upload-alt me-1"></i>Arrastra aquí o <u>haz clic</u>`;
        document.getElementById('archivo').removeAttribute('disabled');
        document.getElementById('archivo').value = '';
        document.getElementById('status-file-ingreso').innerHTML = '';
        $('#archivo_server').val('');
        $('#archivo_usuario').val('');
    }
